cabal-version:   3.0
name:            haskell-ai-agent
version:         0.1.0.0
build-type:      Simple

common warnings
    ghc-options: -Wall

library
    import: warnings
    exposed-modules:
        Agent.Core
        Agent.Agent
        Model.OpenAI
    hs-source-dirs: src
    build-depends:
        base,
        aeson,
        bytestring,
        containers,
        data-default,
        http-client,
        http-conduit,
        mtl,
        scientific,
        text,
        vector,
        extra
    default-language: Haskell2010

executable example-guardrail
    import:           warnings
    main-is:          Guardrail.hs
    build-depends:
        base,
        haskell-ai-agent,
        data-default,
        mtl,
        text
    hs-source-dirs:   examples
    default-language: Haskell2010

executable example-tooluse
    import:           warnings
    main-is:          ToolUse.hs
    build-depends:
        base,
        haskell-ai-agent,
        data-default,
        mtl,
        text
    hs-source-dirs:   examples
    default-language: Haskell2010

executable example-subagents
    import:           warnings
    main-is:          SubAgents.hs
    build-depends:
        base,
        haskell-ai-agent,
        data-default,
        mtl,
        text
    hs-source-dirs:   examples
    default-language: Haskell2010
